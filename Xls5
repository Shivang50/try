def build_operation_names(mode, map_voltage, resistance):
    supplies = [x.strip() for x in map_voltage.split(":") if x.strip()]
    resistances = [x.strip() for x in resistance.split(":") if x.strip()]

    names = []

    if resistances:
        for sup in supplies:
            for res in resistances:
                names.append(f"{mode}_{sup}_{res}")
    else:
        for sup in supplies:
            names.append(f"{mode}_{sup}")

    return names

def generate_operation_model_block(table4_rows):

    out = []
    out.append("\t:operation-model\t\t'(\n")

    for row in table4_rows:

        mode = row.get("Mode", "").strip()
        map_voltage = row.get("Map_voltage", "").strip()
        resistance = row.get("Resistance", "").strip()

        remove_name = row.get("Remove_name", "").strip()

        op_names = build_operation_names(
            mode,
            map_voltage,
            resistance
        )

        for op in op_names:

            ##################################################
            # Bidir_TX / Bidir_TX1
            ##################################################

            if mode in ("Bidir_TX", "Bidir_TX1"):

                out.append(f"\t\t\t\t\t({op} (delay-only function slope intenergy) (\n")

                out.append("\t\t\t\t\t\t(:stuck-to )\n")
                out.append("\t\t\t\t\t\t(:keep-stuck-pins-in-cond )\n")
                out.append("\t\t\t\t\t\t(:forbidden )\n")
                out.append("\t\t\t\t\t\t(:map-voltage )\n")
                out.append("\t\t\t\t\t\t(:cload )\n")
                out.append("\t\t\t\t\t\t(:slope-threshold )\n")
                out.append("\t\t\t\t\t\t(:delay-threshold )\n")
                out.append("\t\t\t\t\t\t(:pin-voltage )\n")
                out.append("\t\t\t\t\t\t(:electrical )\n")
                out.append('\t\t\t\t\t\t(:include ("$Path"))\n')

                if remove_name:
                    out.append(f"\t\t\t\t\t\t(:remove-name {remove_name})\n")

                out.append("\t\t\t\t\t))\n\n")

            ##################################################
            # Bidir_RX
            ##################################################

            elif mode == "Bidir_RX":

                out.append(f"\t\t\t\t\t({op} (delay-only function slope intenergy) (\n")

                out.append("\t\t\t\t\t\t(:stuck-to )\n")
                out.append("\t\t\t\t\t\t(:keep-stuck-pins-in-cond )\n")
                out.append("\t\t\t\t\t\t(:forbidden )\n")
                out.append("\t\t\t\t\t\t(:map-voltage )\n")
                out.append("\t\t\t\t\t\t(:slope )\n")
                out.append("\t\t\t\t\t\t(:slope-threshold )\n")
                out.append("\t\t\t\t\t\t(:delay-threshold )\n")
                out.append("\t\t\t\t\t\t(:electrical )\n")
                out.append('\t\t\t\t\t\t(:include ("$Path"))\n')

                if remove_name:
                    out.append(f"\t\t\t\t\t\t(:remove-name {remove_name})\n")

                out.append("\t\t\t\t\t))\n\n")

            ##################################################
            # Leak
            ##################################################

            elif mode.lower() == "leak":

                out.append(f"\t\t\t\t\t({op} (leakpower) (\n")

                out.append("\t\t\t\t\t\t(:map-voltage )\n")
                out.append("\t\t\t\t\t\t(:stuck-to )\n")
                out.append('\t\t\t\t\t\t(:include ("$Path"))\n')

                if remove_name:
                    out.append(f"\t\t\t\t\t\t(:remove-name {remove_name})\n")

                out.append("\t\t\t\t\t))\n\n")

            ##################################################
            # Only_cap
            ##################################################

            elif mode.lower() == "only_cap":

                out.append(f'\t\t\t\t\t({op} ".*" (capa) (\n')

                out.append("\t\t\t\t\t\t(:map-voltage )\n")
                out.append("\t\t\t\t\t\t(:stuck-to )\n")
                out.append('\t\t\t\t\t\t(:include ("$Path"))\n')

                if remove_name:
                    out.append(f"\t\t\t\t\t\t(:remove-name {remove_name})\n")

                out.append("\t\t\t\t\t))\n\n")

    out.append("\t)\n")

    return out


op_block = generate_operation_model_block(table4_rows)


