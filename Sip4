"""
check_sip_lef() and its LEF-parsing helpers.

Drop these into your main script. parse_lef() is unchanged from your original.
Globals expected from your main script: UPT_BASE, product_name, mat10_version, libname
"""

import re
import csv
from pathlib import Path

SIP_LEF_DUMP = "sip_lef_dump.txt"


def parse_lef(lef_path: str):
    records = []

    macro_name = None
    pin_name = None
    in_port = False

    macro_re = re.compile(r'^\s*MACRO\s+(\S+)\s*$')
    pin_re = re.compile(r'^\s*PIN\s+(\S+)\s*$')
    port_re = re.compile(r'^\s*PORT\s*$')
    layer_re = re.compile(r'^\s*LAYER\s+(\S+)\s*;')
    end_re = re.compile(r'^\s*END\s+(\S+)\s*$')
    end_port_re = re.compile(r'^\s*END\s*$')

    with open(lef_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip()

            m = macro_re.match(line)
            if m:
                macro_name = m.group(1)
                pin_name = None
                in_port = False
                continue

            m = pin_re.match(line)
            if m:
                pin_name = m.group(1)
                in_port = False
                continue

            if port_re.match(line):
                in_port = True
                continue

            if in_port:
                m = layer_re.match(line)
                if m and macro_name and pin_name:
                    records.append((macro_name, pin_name, m.group(1)))
                    continue

                if end_port_re.match(line):
                    in_port = False
                    continue

            m = end_re.match(line)
            if m:
                end_name = m.group(1)

                if pin_name and end_name == pin_name:
                    pin_name = None
                    in_port = False
                    continue

                if macro_name and end_name == macro_name:
                    macro_name = None
                    pin_name = None
                    in_port = False
                    continue

    # Uniquify + sort
    unique_records = sorted(set(records))
    return unique_records


def write_csv(records, out_csv, header=True):
    with open(out_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        if header:
            writer.writerow(["cell_name", "pin_name", "port_layer"])
        writer.writerows(records)


def _pin_layers_from_report_log(report_log):
    """
    Collect every layer that appears in report.log with the "pin" purpose.

    Matches lines of the form:
        difference on lpp:("C5" "pin")
    Returns a set of lowercased layer names.
    """
    pin_layers = set()
    lpp_re = re.compile(r'lpp\s*:\s*\(\s*"([^"]+)"\s+"([^"]+)"\s*\)')

    with open(report_log, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            m = lpp_re.search(line)
            if m and m.group(2).strip().lower() == "pin":
                pin_layers.add(m.group(1).strip().lower())

    return pin_layers


def check_sip_lef():
    """
    Returns "Yes" or "No".

    "No"  -> SIP LEF file missing, or no qualifying port layer found
    "Yes" -> port layers include nitride, or one of them appears in
             report.log with the "pin" purpose
    """
    lef_path = (
        Path(UPT_BASE)
        / product_name
        / mat10_version
        / "SIP"
        / "physical"
        / f"{libname}.lef"
    )

    if not lef_path.is_file():
        return "No"

    records = parse_lef(str(lef_path))

    cwd = Path.cwd()
    dump_file = cwd / SIP_LEF_DUMP
    write_csv(records, str(dump_file), header=False)

    # Unique third-column values, first-seen order preserved
    port_layers = []
    for _cell, _pin, layer in records:
        if layer not in port_layers:
            port_layers.append(layer)

    if not port_layers:
        return "No"

    if any(layer.lower() == "nitride" for layer in port_layers):
        return "Yes"

    report_log = cwd / "Output" / "report.log"
    if not report_log.is_file():
        return "No"

    pin_layers = _pin_layers_from_report_log(report_log)

    for layer in port_layers:
        if layer.lower() in pin_layers:
            return "Yes"

    return "No"
