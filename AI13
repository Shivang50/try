import csv

# Disable SSL warnings
urllib3.disable_warnings(
    urllib3.exceptions.InsecureRequestWarning
)


# Read, filter, sort LPP lines

def read_diff_lines_from_log(file_path="report.log"):

    unique_lpps = set()

    try:

        full_path = os.path.join(
            os.getcwd(),
            file_path
        )

        if not os.path.exists(full_path):

            print(
                f"Error: {file_path} not found "
                "in current directory."
            )

            sys.exit(1)

        pattern = re.compile(
            r'difference[s]?\s+on\s+lpp\s*:\s*\("([^"]+)"\s+"([^"]+)"\)',
            re.IGNORECASE
        )

        with open(full_path, "r") as file:

            for line in file:

                line = line.strip()

                match = pattern.search(line)

                if match:

                    layer = match.group(1).strip()
                    purpose = match.group(2).strip()

                    # Exclude instance drawing
                    if (
                        layer.lower() == "instance"
                        and purpose.lower() == "drawing"
                    ):
                        continue

                    unique_lpps.add(
                        (layer, purpose)
                    )

        if not unique_lpps:

            print(
                "No valid LPP differences found."
            )

            sys.exit(1)

        sorted_lpps = sorted(unique_lpps)

        diff_lines = [

            f'difference on lpp:("{layer}" "{purpose}")'

            for layer, purpose
            in sorted_lpps
        ]

        print(
            "\nTotal unique LPPs:",
            len(diff_lines)
        )

        print("\nLPPs being sent to LLM:\n")

        for lpp in diff_lines:
            print(lpp)

        return diff_lines

    except Exception as e:

        print(
            "Error reading log file:",
            e
        )

        sys.exit(1)



# prompt

def build_prompt(diff_lines):

    base_prompt = (

        "You are an expert in physical design and library QA. I will give you a layout diff report (Calibre/LVS-style) and a detailed per-LPP impact table that you already produced."
		"Using that information, I want you to summarize the impact at *library level* (not per LPP).\n\nInput context:\n- The diff report lists many `difference on lpp:(\"layer\" \"purpose\")` lines for several cells of the same IO library.\n-"
		"You previously analyzed each LPP and concluded which views are impacted: GDS/layout, LEF/abstract, extracted netlist, CDL, liberty, and verilog.\n-"
		"Now we want a single compact summary by view, at library level.\n\nTASK:\n"
		"1. Create a Markdown table with exactly these columns:\n   - View\n   - Impacted?\n   - Reason / Summary\n\n"
		"2. For the \"Impacted?\" column, always start with either:\n   - `Yes`\n   - `No`\n   - `No (likely)` if it is not directly impacted but there is some indirect risk.\n\n"
		"3. In the \"Reason / Summary\" column, give a short, concise explanation in one paragraph per row.\n\n"
		"4. The views to consider are:\n   - GDS (layout)\n   - LEF / abstract\n   - Extracted netlist (LVS/PEX)\n   - CDL\n   - Liberty\n   - Verilog\n\n"
		"5. Base your reasoning on typical CMOS IO library flows (GDS \u2192 LEF \u2192 extraction \u2192 CDL \u2192 liberty/verilog), and on how LPP changes affect each view.\n\n"
		"6. Return ONLY the Markdown table, no extra prose before or after.\n\n"
		"Here is the diff report (for context):\n[PASTE diff_report.txt CONTENT HERE]\n\n"
		"Here is the per-LPP analysis you previously produced (for context):\n[PASTE the big LPP impact table HERE]\n\n"
		"Now generate the requested library-level impact summary table."

    )

    formatted_lines = "\n".join(diff_lines)

    return base_prompt + formatted_lines



# Convert Markdown table to CSV

def save_markdown_table_as_csv(content):

    rows = []

    for line in content.splitlines():

        line = line.strip()

        if not line.startswith("|"):
            continue

        if set(
            line.replace("|", "").strip()
        ) == {"-"}:
            continue

        parts = [

            p.strip()

            for p in line.split("|")

            if p.strip()
        ]

        if parts:
            rows.append(parts)

    if not rows:

        print(
            "\nNo table detected in response."
        )

        return

    output_file = "lpp_impact_report.csv"

    with open(
        output_file,
        "w",
        newline="",
        encoding="utf-8"
    ) as csvfile:

        writer = csv.writer(csvfile)

        writer.writerows(rows)

    print(
        "\nSaved output to:",
        output_file
    )



# Generate token and call API

def generate_token_and_call_api(
    api_key,
    client_app_name,
    prompt
):

    service_name = "chat"

    url = (
        "https://api-ai-bridge.st.com/"
        "chatgpt/api/client-apps"
    )

    timestamp = int(time.time())

    nonce = random.randint(
        100000,
        999999
    )

    data = (
        f"{client_app_name}_"
        f"{service_name}_"
        f"{api_key}_"
        f"{timestamp}_"
        f"{nonce}"
    )

    hash_object = hashlib.sha1(
        data.encode()
    )

    token = hash_object.hexdigest()

    print("\nAPI call details:")

    print("timestamp:", timestamp)
    print("nonce:", nonce)
    print("serviceName:", service_name)
    print("clientAppName:", client_app_name)

    request_body = {

        "version": 1,
        "clientAppName": client_app_name,
        "service": service_name,
        "timestamp": timestamp,

        "messages": [
            {
                "role": "user",
                "content": prompt
            }
        ],

        "temperature": 1,
        "persona": "st_copilot",

        
        "responseFormat": "text"
    }

    try:

        response = requests.post(

            url,

            json=request_body,

            headers={

                "stchatgpt-auth-token":
                    token,

                "stchatgpt-auth-nonce":
                    str(nonce)

            },

            verify=False,

            timeout=60
        )

        response.raise_for_status()

        response_json = response.json()

        content = response_json.get(
            "completion",
            ""
        )

        
        # Retry once if empty
        

        if not content:

            print(
                "\nLLM returned empty response."
            )

            print("Retrying once...\n")

            time.sleep(2)

            response = requests.post(
                url,
                json=request_body,
                headers={
                    "stchatgpt-auth-token": token,
                    "stchatgpt-auth-nonce": str(nonce)
                },
                verify=False,
                timeout=60
            )

            response.raise_for_status()

            response_json = response.json()

            content = response_json.get(
                "completion",
                ""
            )

            if not content:

                print(
                    "\nLLM still returned empty response."
                )

                print(response_json)

                return

        print(
            "\nResponse length:",
            len(content)
        )

        

        print(content[:500])

        

        print(content)

        save_markdown_table_as_csv(
            content
        )

    except requests.exceptions.RequestException as error:

        if error.response is not None:

            print(
                "\nError:",
                error.response.text
            )

        else:

            print(
                "\nError:",
                error
            )



# MAIN

if len(sys.argv) != 3:

    print(
        "Usage: python script.py "
        "<apiKey> <clientAppName>"
    )

    sys.exit(1)


api_key = sys.argv[1]

client_app_name = sys.argv[2]


diff_lines = read_diff_lines_from_log()

prompt = build_prompt(
    diff_lines
)

generate_token_and_call_api(
    api_key,
    client_app_name,
    prompt
)
