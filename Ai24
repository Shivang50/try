# Move intermediate files into intermediate_logs

items_to_move = [
    "cds.lib",
    "cds.lib.task1",
    "menus",
    "nominal",
    "out.log",
    "replay1.il",
    "replay.il",
    "Summary.txt",
    "topcell.list",
    "uk-init.il",
    "XORLIB",
    "Diff_Logs"
]

for item in items_to_move:

    src = cwd / item
    dst = intermediate_dir / item

    if src.exists():

        if dst.exists():

            if dst.is_dir():
                shutil.rmtree(dst)
            else:
                dst.unlink()

        shutil.move(str(src), str(dst))

    else:
        print(f"WARNING: {item} not found — skipping")
