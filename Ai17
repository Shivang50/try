def run_gen_dot_ucdprod(dpds_value: str, pdk_value: str):

    script_path = Path.cwd() / "Scripts" / "gen_dot_ucdprod.csh"

    if not script_path.is_file():
        raise RuntimeError(
            f"gen_dot_ucdprod.csh not found: {script_path}"
        )

    dpds_parts = dpds_value.split(maxsplit=1)
    pdk_parts = pdk_value.split(maxsplit=1)

    if len(dpds_parts) != 2:
        raise ValueError("dpds must be: name version")

    if len(pdk_parts) != 2:
        raise ValueError("PDK must be: name version")

    env = os.environ.copy()

    env["DPDS_NAME"] = dpds_parts[0]
    env["DPDS_VERSION"] = dpds_parts[1]

    env["PDK_NAME"] = pdk_parts[0]
    env["PDK_VERSION"] = pdk_parts[1]

    print("\nRunning gen_dot_ucdprod.csh ...")

    result = subprocess.run(
        ["csh", str(script_path)],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if result.returncode != 0:
        raise RuntimeError(
            "Failed to run gen_dot_ucdprod.csh\n"
            f"stdout:\n{result.stdout}\n"
            f"stderr:\n{result.stderr}"
        )

    print("gen_dot_ucdprod.csh completed")




import os

DPDS_name = os.environ.get("DPDS_NAME")
DPDS_version = os.environ.get("DPDS_VERSION")

PDK_name = os.environ.get("PDK_NAME")
PDK_version = os.environ.get("PDK_VERSION")

if not DPDS_name:
    raise RuntimeError("DPDS_NAME not provided")

if not DPDS_version:
    raise RuntimeError("DPDS_VERSION not provided")

if not PDK_name:
    raise RuntimeError("PDK_NAME not provided")

if not PDK_version:
    raise RuntimeError("PDK_VERSION not provided")
