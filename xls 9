def resolve_stuck_to(stuck_to_text, table2_map):

    if not stuck_to_text:
        return ""

    resolved = []

    for key in split_values(stuck_to_text):

        key = key.strip()

        if key in table2_map:
            resolved.append(table2_map[key])

    return "".join(resolved)

def build_operation_names(mode, map_voltage, resistance):
    map_list = split_values(map_voltage)
    res_list = split_values(resistance)

    names = []

    if res_list:
        for mv in map_list:
            for res in res_list:
                names.append(f"{mode}_{mv}_{res}")
    else:
        for mv in map_list:
            names.append(f"{mode}_{mv}")

    return names


def extract_supply(op_name):
    """
    Extract SUP1, SUP2, SUP3... from operation name.

    Example:
        Bidir_TX_SUP1_R1 -> SUP1
        Bidir_RX_SUP3 -> SUP3
        leak_SUP2 -> SUP2
    """

    m = re.search(r"(SUP\d+)", op_name)

    if m:
        return m.group(1)

    return ""


def write_bidir_tx(
        out,
        op_name,
        map_voltage,
        stuck_to,
        keep_stuck,
        forbidden,
        pin_voltage,
        electrical,
        include_file,
        remove_name,
        bidir):

    out.append(
        f"\t\t\t\t\t({op_name} (delay-only function slope intenergy) (\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:stuck-to ({stuck_to}))\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:keep-stuck-pins-in-cond ({keep_stuck}))\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:forbidden ({forbidden}))\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:map-voltage ({map_voltage}))\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:cload {bidir.get('cload','')})\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:slope-threshold {bidir.get('slope_threshold','')})\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:delay-threshold {bidir.get('delay_threshold','')})\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:pin-voltage ({pin_voltage}))\n"
    )

    out.append(
        f"\t\t\t\t\t\t(:electrical ({electrical}))\n"
    )

    out.append(
        f'\t\t\t\t\t\t(:include ("{include_file}"))\n'
    )

    if remove_name:
        out.append(
            f"\t\t\t\t\t\t(:remove-name ({remove_name}))\n"
        )

    out.append(
        "\t\t\t\t\t))\n"
    )


