def extract_scm_attribute(scm_lines, attr):
    text = "".join(scm_lines)
    m = re.search(re.escape(attr) + r"\s*'", text)
    if not m:
        return ""

    i = text.find("(", m.end())
    if i == -1:
        return ""

    depth = 0
    for j in range(i, len(text)):
        if text[j] == "(":
            depth += 1
        elif text[j] == ")":
            depth -= 1
            if depth == 0:
                return text[i + 1:j].strip()
    return ""


def apply_pin_voltage_overrides(base, overrides):
    ov = {}
    for grp in re.findall(r"\(([^()]*)\)", overrides):
        toks = grp.split()
        if toks:
            ov[toks[0]] = grp.strip()

    result = []
    seen = set()

    for grp in re.findall(r"\(([^()]*)\)", base):
        toks = grp.split()
        key = toks[0] if toks else ""
        if key in ov:
            result.append("(" + ov[key] + ")")
            seen.add(key)
        else:
            result.append("(" + grp.strip() + ")")

    for key, val in ov.items():
        if key not in seen:
            print(f"Warning: pin-voltage override {key} not found in .scm :pin-voltage")
            result.append("(" + val + ")")

    return "".join(result)


