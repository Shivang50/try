def load_ucdprod_env():
    script_dir = Path(__file__).resolve().parent

    tcsh_cmd = f"""
        cd "{script_dir}"
        setenv UCDPRJDIR $PWD
        eval `ukerEnv`
        if ($status != 0) then
            echo "ERROR: eval `ukerEnv` failed" >&2
            exit 1
        endif
        echo "ucdprod environment loaded successfully."
        env
    """

    try:
        result = subprocess.run(
            ["tcsh", "-c", tcsh_cmd],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except subprocess.CalledProcessError as e:
        print("Failed to load ucdprod environment.")
        if e.stderr:
            print("stderr from tcsh:\n", e.stderr)
        sys.exit(1)

    stdout_lines = result.stdout.splitlines()
    if stdout_lines:
        print(stdout_lines[0])

    for line in stdout_lines[1:]:
        if "=" in line:
            key, value = line.split("=", 1)
            os.environ[key] = value


def get_basic_lib_path():
    try:
        which_res = subprocess.run(
            ["bash", "-c", "which virtuoso"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
        )
        virtuoso_full = which_res.stdout.strip()
        if not virtuoso_full:
            return None
    except subprocess.CalledProcessError:
        return None

    try:
        cut_res = subprocess.run(
            ["bash", "-c",
             f'echo "{virtuoso_full}" | cut -d"/" -f1,2,3,4,5,6'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
        )
        virtuoso_path = cut_res.stdout.strip()
        if not virtuoso_path:
            return None
    except subprocess.CalledProcessError:
        return None

    return f"{virtuoso_path}/tools.lnx86/dfII/etc/cdslib/basic"


def build_three_lines(libname: str, libpath_for_third: str):

    dkitroot = os.environ.get("DKITROOT")
    if not dkitroot:
        raise RuntimeError("DKITROOT is not set in the environment.")

    pattern = os.path.join(dkitroot, "*.cdslib")
    matches = glob.glob(pattern)

    if not matches:
        raise RuntimeError(
            f"No .cdslib file found under DKITROOT: {pattern}"
        )

    cdslib_path = matches[0]
    soft_line = f"SOFTINCLUDE {cdslib_path}\n"

    basic_lib_path = get_basic_lib_path()

    if not basic_lib_path:
        raise RuntimeError(
            "Could not determine virtuoso path (basicLibPath)."
        )

    basic_line = f"DEFINE basic {basic_lib_path}\n"

    cdsoa_path = os.path.join(
        libpath_for_third,
        "CADENCE",
        "CDSOA"
    )

    oa_path = os.path.join(
        libpath_for_third,
        "OA"
    )

    if os.path.isdir(cdsoa_path):
        third_target = cdsoa_path

    elif os.path.isdir(oa_path):
        third_target = oa_path

    else:
        raise RuntimeError(
            "Could not find valid directory structure"
        )

    third_line = f"DEFINE {libname} {third_target}\n"

    return [
        soft_line,
        basic_line,
        third_line
    ]


def get_techlib() -> str:
    script_dir = Path(__file__).resolve().parent

    tcsh_cmd = f"""
        cd "{script_dir}"
        setenv UCDPRJDIR $PWD
        eval `ukerEnv`
        set techlib = `piGetInfo "$DKITROOT/" processLibName`
        echo "$techlib"
    """

    result = subprocess.run(
        ["tcsh", "-c", tcsh_cmd],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    lines = [
        ln.strip()
        for ln in result.stdout.splitlines()
        if ln.strip()
    ]

    return lines[-1]


def overwrite_cds_lib(
    cds_lib_path: str,
    libname: str,
    libpath_for_third: str
):

    lines = build_three_lines(
        libname,
        libpath_for_third
    )

    dir_name = os.path.dirname(
        cds_lib_path
    )

    if dir_name:
        os.makedirs(
            dir_name,
            exist_ok=True
        )

    with open(
        cds_lib_path,
        "w"
    ) as f:
        f.writelines(lines)


def cp2pwd(skill: str) -> Path:
    skill_path = Path(skill)
    if not skill_path.is_file():
        raise RuntimeError(
            f"Source file not found: {skill}"
        )
    dst_path = Path.cwd() / skill_path.name
    shutil.copy2(skill_path, dst_path)
    return dst_path


def edit_replay1(
    path: Path,
    reflib: str,
    techlib: str,
    topcell_list: str
):

    lines = path.read_text().splitlines()

    new_lines = []

    new_reflib = f'reflib="{reflib}"'
    new_top = f'topCellList="{topcell_list}"'
    new_tech = f'techlib="{techlib}"'

    for line in lines:
        stripped = line.strip()

        if stripped.startswith("reflib="):
            new_lines.append(new_reflib)

        elif stripped.startswith("topCellList="):
            new_lines.append(new_top)

        elif stripped.startswith("techlib="):
            new_lines.append(new_tech)

        else:
            new_lines.append(line)

    path.write_text(
        "\n".join(new_lines) + "\n"
    )


