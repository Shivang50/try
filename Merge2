def read_diff_lines_from_log(
    file_path="report.log"
):

    unique_lpps = set()

    full_path = os.path.join(
        os.getcwd(),
        file_path
    )

    if not os.path.exists(full_path):

        print(
            f"Error: {file_path} not found "
            "in current directory."
        )

        sys.exit(1)

    pattern = re.compile(
        r'difference[s]?\s+on\s+lpp\s*:\s*\("([^"]+)"\s+"([^"]+)"\)',
        re.IGNORECASE
    )

    with open(
        full_path,
        "r"
    ) as file:

        for line in file:

            line = line.strip()

            match = pattern.search(
                line
            )

            if match:

                layer = match.group(1).strip()
                purpose = match.group(2).strip()

                if (
                    layer.lower() == "instance"
                    and purpose.lower() == "drawing"
                ):
                    continue

                unique_lpps.add(
                    (layer, purpose)
                )

    if not unique_lpps:

        print(
            "No valid LPP differences found."
        )

        sys.exit(1)

    sorted_lpps = sorted(unique_lpps)

    diff_lines = [

        f'difference on lpp:("{layer}" "{purpose}")'

        for layer, purpose
        in sorted_lpps

    ]

    print(
        "\nTotal unique LPPs:",
        len(diff_lines)
    )

    print(
        "\nLPPs being sent to LLM:\n"
    )

    for lpp in diff_lines:
        print(lpp)

    return diff_lines


def build_prompt(diff_lines):

    base_prompt = (

        "You are an expert in semiconductor layout analysis.\n\n"

        "Given the following layout diff lines "
        "(difference on lpp:(\"layer\" \"purpose\")), "
        "create a clear table.\n\n"

        "Return ONLY a Markdown table.\n"

        "Columns must be:\n"
        "LPP | Meaning | Impact on GDS | "
        "Impact on LEF/abstract | "
        "Impact on extracted netlist | "
        "Impact on CDL | "
        "Impact on liberty | "
        "Impact on verilog | "
        "Notes/Risk\n\n"

        "Here are the diff lines:\n"

    )

    formatted_lines = "\n".join(
        diff_lines
    )

    return base_prompt + formatted_lines


def save_markdown_table_as_csv(
    content
):

    rows = []

    for line in content.splitlines():

        line = line.strip()

        if not line.startswith("|"):
            continue

        if set(
            line.replace("|", "").strip()
        ) == {"-"}:
            continue

        parts = [

            p.strip()

            for p in line.split("|")

            if p.strip()

        ]

        if parts:
            rows.append(parts)

    if not rows:

        print(
            "\nNo table detected in response."
        )

        return

    output_file = "lpp_impact_report.csv"

    with open(
        output_file,
        "w",
        newline="",
        encoding="utf-8"
    ) as csvfile:

        writer = csv.writer(
            csvfile
        )

        writer.writerows(rows)

    print(
        "\nSaved output to:",
        output_file
    )


def generate_token_and_call_api(
    api_key,
    client_app_name,
    prompt
):

    service_name = "chat"

    url = (
        "https://api-ai-bridge.st.com/"
        "chatgpt/api/client-apps"
    )

    timestamp = int(
        time.time()
    )

    nonce = random.randint(
        100000,
        999999
    )

    data = (
        f"{client_app_name}_"
        f"{service_name}_"
        f"{api_key}_"
        f"{timestamp}_"
        f"{nonce}"
    )

    hash_object = hashlib.sha1(
        data.encode()
    )

    token = hash_object.hexdigest()

    request_body = {

        "version": 1,
        "clientAppName": client_app_name,
        "service": service_name,
        "timestamp": timestamp,

        "messages": [
            {
                "role": "user",
                "content": prompt
            }
        ],

        "temperature": 1,
        "persona": "st_copilot",

        "responseFormat": "text"
    }

    response = requests.post(
        url,
        json=request_body,
        headers={
            "stchatgpt-auth-token": token,
            "stchatgpt-auth-nonce": str(nonce)
        },
        verify=False,
        timeout=60
    )

    response.raise_for_status()

    response_json = response.json()

    content = response_json.get(
        "completion",
        ""
    )

    save_markdown_table_as_csv(
        content
    )


