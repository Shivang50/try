def create_upt_symlink_structure(product_name: str, be_version: str, mat10_version: str):
    """
    Inside ./<product_name>/ create:
      - BE_UPT/<product_name>@<be_version> with symlinks to source BE version files
      - MAT10_UPT/<product_name>@<mat10_version> with symlinks to source MAT10 version files

    If the expected BE/MAT10 source directory is missing, ask the user to provide the corresponding database area path.
    """
    base_dir = Path.cwd()

    be_upt_dir = base_dir / "BE_UPT"
    mat10_upt_dir = base_dir / "MAT10_UPT"

    be_target_dir = be_upt_dir / f"{product_name}@{be_version}"
    mat10_target_dir = mat10_upt_dir / f"{product_name}@{mat10_version}"

    default_be_source_dir = Path(f"/work/uptpluscache/areas/trd/{product_name}/{be_version}")
    default_mat10_source_dir = Path(f"/work/uptpluscache/areas/trd/{product_name}/{mat10_version}")

    # Create target directories
    be_target_dir.mkdir(parents=True, exist_ok=True)
    mat10_target_dir.mkdir(parents=True, exist_ok=True)

    # Resolve BE source directory
    be_source_dir = default_be_source_dir
    if not be_source_dir.is_dir():
        user_path = input(
            f"BE database area not found at '{default_be_source_dir}'. "
            f"Please provide the BE database area path in format (e.g. /work/uptpluscache/areas/trd/<product_name>/<be_version> ) : "
        ).strip()
        be_source_dir = Path(user_path)
        if not be_source_dir.is_dir():
            raise FileNotFoundError(f"BE database area not found: {be_source_dir}")

    # Resolve MAT10 source directory
    mat10_source_dir = default_mat10_source_dir
    if not mat10_source_dir.is_dir():
        user_path = input(
            f"MAT10 database area not found at '{default_mat10_source_dir}'. "
            f"Please provide the MAT10 database area path in format (e.g. /work/uptpluscache/areas/trd/<product_name>/<reference_MAT10_version> ) : "
        ).strip()
        mat10_source_dir = Path(user_path)
        if not mat10_source_dir.is_dir():
            raise FileNotFoundError(f"MAT10 database area not found: {mat10_source_dir}")

    # Create symlinks for BE
    create_symlinks_from_source(be_source_dir, be_target_dir)

    # Create symlinks for MAT10
    create_symlinks_from_source(mat10_source_dir, mat10_target_dir)

    print(f"Created BE_UPT structure at: {be_target_dir}")
    print(f"Created MAT10_UPT structure at: {mat10_target_dir}")


def create_symlinks_from_source(source_dir: Path, target_dir: Path):
    if not source_dir.is_dir():
        raise FileNotFoundError(f"Source directory not found: {source_dir}")

    for item in source_dir.iterdir():
        dst = target_dir / item.name

        if dst.exists() or dst.is_symlink():
            if dst.is_dir() and not dst.is_symlink():
                shutil.rmtree(dst)
            else:
                dst.unlink()

        dst.symlink_to(item.resolve())
        



def MAT09_CREATION(product_name: str, be_version: str, mat10_version: str, process: str, leaf_cells_present: bool, leaf_be_file: Path):
    """
    Inside ./<product_name>/SAND_MAT10/MAT09:
      - if process contains "CMOSP28" or "P28":
          check these three possible cadence sources in order and use the first directory found:
            1) BE_UPT/<product_name>@<be_version>/CADENCE/CDSOA
            2) BE_UPT/<product_name>@<be_version>/OA
            3) BE_UPT/<product_name>@<be_version>/CDS
        destination remains: SAND_MAT10/MAT09/OA

      - otherwise:
          create symlink to BE_UPT/<product_name>@<be_version>/CADENCE/CDSOA
          destination: SAND_MAT10/MAT09/CADENCE/CDSOA

      - create symlink to behaviour, libs, packaging from MAT10_UPT/<product_name>@<mat10_version>
      - copy INTERFACE from MAT10_UPT/<product_name>@<mat10_version>
    """
    base_dir = Path.cwd()

    sand_mat10_dir = base_dir / "SAND_MAT10"
    mat09_dir = sand_mat10_dir / "MAT09"

    be_root = base_dir / "BE_UPT" / f"{product_name}@{be_version}"
    mat10_root = base_dir / "MAT10_UPT" / f"{product_name}@{mat10_version}"

    mat09_dir.mkdir(parents=True, exist_ok=True)

    # Choose CADENCE paths based on process
    if "CMOSP28" in process or "P28" in process:
        possible_cadence_sources = [
            be_root / "CADENCE" / "CDSOA",
            be_root / "OA",
            be_root / "CDS",
        ]

        cadence_src = None
        for src in possible_cadence_sources:
            if src.is_dir():
                cadence_src = src
                break

        if cadence_src is None:
            raise FileNotFoundError(
                "None of the expected cadence source directories were found for P28/CMOSP28: "
                + ", ".join(str(p) for p in possible_cadence_sources)
            )

        cadence_dst = mat09_dir / "OA"

    else:
        cadence_src = be_root / "CADENCE" / "CDSOA"
        if not cadence_src.is_dir():
            raise FileNotFoundError(f"CADENCE source directory not found: {cadence_src}")

        cadence_dst = mat09_dir / "CADENCE" / "CDSOA"

    # Sources from MAT10
    behaviour_src = mat10_root / "behaviour"
    libs_src = mat10_root / "libs"
    packaging_src = mat10_root / "packaging"
    interface_src = mat10_root / "INTERFACE"

    # Destinations
    behaviour_dst = mat09_dir / "behaviour"
    libs_dst = mat09_dir / "libs"
    packaging_dst = mat09_dir / "packaging"
    interface_dst = mat09_dir / "INTERFACE"

    # Create symlinks
    create_symlink_path(cadence_src, cadence_dst)
    create_symlink_path(behaviour_src, behaviour_dst)
    create_symlink_path(libs_src, libs_dst)
    create_symlink_path(packaging_src, packaging_dst)

    # Copy INTERFACE only
    copy_tree(interface_src, interface_dst)
    
    # Update leafcell.list only if leaf cells were generated
    if leaf_cells_present and leaf_be_file is not None:
        leafcell_file = interface_dst / "leafcell.list"
        leafcell_file.parent.chmod(0o777)
        leafcell_file.chmod(0o666)
        leafcell_file.write_text(Path(leaf_be_file).read_text())

    print(f"MAT09 setup completed at: {mat09_dir}")


    
def create_symlink_path(src: Path, dst: Path):
    """
    Create a symlink at dst pointing to src.
    If dst exists, remove it first.
    """
    if not src.exists():
        print (f"During MAT09 directory creation, the Softlink for this directory can't be created because Source path not found at MAT10_UPT: {src}")
        return

    if dst.exists() or dst.is_symlink():
        if dst.is_dir() and not dst.is_symlink():
            shutil.rmtree(dst)
        else:
            dst.unlink()

    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.symlink_to(src.resolve())    
    
    
def copy_tree(src: Path, dst: Path):
    if not src.is_dir():
        print (f"During MAT09 directory creation, Source directory not found at MAT10_UPT: {src}")
        return

    if dst.exists():
        if dst.is_dir():
            shutil.rmtree(dst)
        else:
            dst.unlink()

    shutil.copytree(src, dst)







