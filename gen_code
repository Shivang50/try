def backup_existing_outputs():
    cwd = Path.cwd()
    analyzer_dir = cwd / "Analyzer"
    backup_dir = cwd / "Backup"

    items_to_backup = []

    if analyzer_dir.exists():
        items_to_backup.append(analyzer_dir)
    if not items_to_backup:
        return

    backup_dir.mkdir(parents=True, exist_ok=True)

    for src in items_to_backup:
        dst = backup_dir / src.name

        if dst.exists():
            if dst.is_dir():
                shutil.rmtree(dst)
            else:
                dst.unlink()

        shutil.move(str(src), str(dst))

