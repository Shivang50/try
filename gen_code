def extract_cell_names_from_report(report_path: str):
    cell_names = []

    if not os.path.exists(report_path):
        return cell_names

    cell_pattern = re.compile(r'Cell:([^\s\t]+)')

    with open(report_path, "r", encoding="utf-8") as f:
        for line in f:
            match = cell_pattern.search(line)
            if match:
                cell_name = match.group(1).strip()
                if cell_name and cell_name not in cell_names:
                    cell_names.append(cell_name)

    return cell_names




			
