def pin_checking():
    pairs = find_cell_pairs(TERMINAL_LOG_DIR)

    if not pairs:
        print(f"No matching BE/MAT10 file pairs found in: {TERMINAL_LOG_DIR.resolve()}")
        return

    rows = []

    for cell_name, be_file, mat_file in sorted(pairs):
        added, removed = compare_terminals(be_file, mat_file)

        rows.append([
            cell_name,
            " ".join(added) if added else " ",
            " ".join(removed) if removed else " "
        ])

    output_path = TERMINAL_LOG_DIR / OUTPUT_CSV
    write_csv(rows, output_path)

    #print(f"Terminal report written to: {output_path.resolve()}")
    print(f"Terminal report written to: Intermediate_logs/Terminal_Logs/terminal_diff_report.csv")
    print(f"Total cells processed: {len(rows)}")


