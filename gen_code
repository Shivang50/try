def compare_bbview_files(product_name: str, mat10_version: str):
    sand_mat10_dir = Path.cwd()
    generated_bbview = sand_mat10_dir / "SANDBOX" / "packaging" / "vc.bbview"
    product_root = sand_mat10_dir.parent
    mat10_bbview = (
        product_root
        / "MAT10_UPT"
        / f"{product_name}@{mat10_version}"
        / "packaging"
        / "vc.bbview"
    )
    output_path = sand_mat10_dir / "bbview_comparison"

    with open(mat10_bbview, "r", encoding="utf-8", errors="ignore") as f:
        mat10_lines = f.readlines()

    with open(generated_bbview, "r", encoding="utf-8", errors="ignore") as f:
        generated_lines = f.readlines()

    def extract_map_section(lines):
        start_index = None
        end_index = None

        for idx, line in enumerate(lines):
            if line.strip() == "MAP":
                start_index = idx + 1
                continue

            if line.strip() == "END" and start_index is not None:
                end_index = idx
                break

        if start_index is None or end_index is None:
            return []

        return lines[start_index:end_index]

    # Keep only lines between MAP and END
    mat10_map_lines = extract_map_section(mat10_lines)
    generated_map_lines = extract_map_section(generated_lines)

    extra_lines = []

    i = 0
    j = 0

    while i < len(mat10_map_lines) and j < len(generated_map_lines):
        if mat10_map_lines[i] == generated_map_lines[j]:
            i += 1
            j += 1
        else:
            extra_lines.append(mat10_map_lines[i])
            i += 1

    while i < len(mat10_map_lines):
        extra_lines.append(mat10_map_lines[i])
        i += 1

    seen = set()
    final_lines = []

    for line in extra_lines:
        stripped = line.strip()
        if not stripped:
            continue

        last_col = stripped.split()[-1]

        if last_col not in seen:
            seen.add(last_col)
            final_lines.append(last_col + "\n")

    with open(output_path, "w", encoding="utf-8") as f:
        f.writelines(final_lines)

    print(f"Processed comparison written to: {output_path}")


def copy_bbview_comparison_files(product_name: str, mat10_version: str, libname: str):
    sand_mat10_dir = Path.cwd()
