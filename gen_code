        print(f"bbview_comparison file not found: {output_path}")
        return

    export_dir.mkdir(parents=True, exist_ok=True)

    with open(output_path, "r", encoding="utf-8", errors="ignore") as f:
        entries = [line.strip() for line in f if line.strip()]

    copied_files = []
    not_copied_files = []

    for rel_path in entries:
        rel_path = rel_path.replace("<library>", libname)

        src = mat10_dir / rel_path
        dst = export_dir / rel_path

        if not src.exists():
            print(f"Not copied (missing): {rel_path}")
