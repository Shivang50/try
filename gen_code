def load_ucdprod_env(ucdprod_dir: Path):
    ucdprod_dir = ucdprod_dir.resolve()

    csh_cmd = f"""
        cd "{ucdprod_dir}"
        setenv UCDPRJDIR $PWD
        eval `ukerEnv`
        if ($status != 0) then
            echo "ERROR: eval `ukerEnv` failed" >&2
            exit 1
