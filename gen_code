        dst.parent.mkdir(parents=True, exist_ok=True)

        try:
            shutil.copy2(src, dst)
            dst.chmod(0o666)  # make copied file writable by everyone
            print(f"Copied: {rel_path}")
            copied_files.append(rel_path)
        except Exception as e:
            print(f"Not copied ({rel_path}): {e}")
            not_copied_files.append(rel_path)

    print("\nSummary:")
    print(f"Copied files: {len(copied_files)}")
    print(f"Not copied files: {len(not_copied_files)}")

