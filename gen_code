def parse_vc_bbview(vc_bbview_path: Path):
    if not vc_bbview_path.is_file():
        raise FileNotFoundError(f"vc.bbview not found: {vc_bbview_path}")

    libname = None
    methodology = None
    process = None
    topcell = []
    in_cells_block = False

    with vc_bbview_path.open("r", encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line:
                continue

            if line.startswith("LIBRARY "):
                parts = line.split()
                if len(parts) >= 2:
                    libname = parts[1].strip()

            if line.startswith("METHODOLOGY "):
                parts = line.split()
                if len(parts) >= 2:
                    methodology = parts[1].strip()

            if line.startswith("PROCESS "):
                parts = line.split()
                if len(parts) >= 2:
                    process = parts[1].strip()
            
            if line == "CELLS":
                in_cells_block = True
                continue

            if line == "END":
                in_cells_block = False
                continue

            if in_cells_block:
                cell_name = line.split()[0]
                topcell.append(cell_name)


    if not libname:
        raise RuntimeError(f"LIBRARY not found in {vc_bbview_path}")

    if not methodology:
        raise RuntimeError(f"METHODOLOGY not found in {vc_bbview_path}")

    if not process:
        raise RuntimeError(f"PROCESS not found in {vc_bbview_path}")

    if not topcell:
        raise RuntimeError(f"No cells found in CELLS block in {vc_bbview_path}")

    return libname, methodology, process, topcell

