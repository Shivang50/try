def generate_token_for_agent(api_key, client_app_name, prompt):
    service_name = "chat"
    url = ("https://api-ai-bridge.st.com/chatgpt/api/client-apps")

    timestamp = int(time.time())
    nonce = random.randint(100000,999999)
    data = (f"{client_app_name}_"f"{service_name}_"f"{api_key}_"f"{timestamp}_"f"{nonce}")
    hash_object = hashlib.sha1(data.encode())
    token = hash_object.hexdigest()

    request_body = {

        "version": 1,
        "clientAppName": client_app_name,
        "service": service_name,
        "timestamp": timestamp,

        "messages": [
            {
                "role": "user",
                "content": prompt
            }
        ],

        "temperature": 0.1,
        "persona": "alfred_for_api",

        
        "responseFormat": "json_object"
    }

    try:

        response = requests.post(

            url,

            json=request_body,

            headers={

                "stchatgpt-auth-token":
                    token,

                "stchatgpt-auth-nonce":
                    str(nonce)

            },

            verify=False,

            timeout=180
        )

        response.raise_for_status()
        response_json = response.json()
        content = response_json.get("completion", "")

        
        # Retry once if empty
        if not content:

            print("\nLLM returned empty response.")
            print("Retrying once again...\n")
            time.sleep(2)
            
            timestamp = int(time.time())
            nonce = random.randint(100000,999999)
            data = (f"{client_app_name}_"f"{service_name}_"f"{api_key}_"f"{timestamp}_"f"{nonce}")
            hash_object = hashlib.sha1(data.encode())
            token = hash_object.hexdigest()

            response = requests.post(
                url,
                json=request_body,
                headers={
                    "stchatgpt-auth-token": token,
                    "stchatgpt-auth-nonce": str(nonce)
                },
                verify=False,
                timeout=180
            )

            response.raise_for_status()
            response_json = response.json()

            content = response_json.get("completion", "")

            if not content:
                print("\nLLM still returned empty response.")

                print(response_json)

                return

        print("\nResponse length:",len(content))
        print(content)
        return content

    except requests.exceptions.RequestException as error:

        if error.response is not None:

            print("\nError:", error.response.text)

        else:

            print("\nError:", error)



def convert_csv_to_text(csv_file_path):
    """
    Read impacted_view_report.csv
    and convert only:
    CAD view, Impact
    into text format for LLM.

    Also return a flag:
    - 1 if Liberty or Verilog impact is Yes
    - 0 if both are No
    """
    import csv

    lines = []
    liberty_verilog_flag = 0

    try:
        with open(csv_file_path, "r", newline="") as csv_file:
            reader = csv.DictReader(csv_file)

            for row in reader:
                cad_view = row["CAD view"].strip()
                impact = row["Impact"].strip()

                lines.append(f"{cad_view}, {impact}")

                if cad_view in ("Liberty", "Verilog") and impact == "Yes":
                    liberty_verilog_flag = 1

        csv_to_text = "\n".join(lines)

        #print("\nOutput of CAD_View_Impact_Analyzer script, sent to LLM:\n")
        #print(csv_to_text)

        return csv_to_text, liberty_verilog_flag

    except Exception as e:
        print("\nError converting CSV to text:", e)
        return "", 0




def parse_impacted_sources(csv_to_text):
    """
    Deterministic pre-check (no LLM): from the CAD-view/impact text,
    return the set of impacted sources we care about (GDS, CDL, LEF).
    Used to decide whether to even call the LLM.
    """
    impacted = set()
    for line in csv_to_text.strip().splitlines():
        if "," not in line:
            continue
        view, impact = (p.strip() for p in line.split(",", 1))
        view_u = view.upper()
        impact_u = impact.upper()
        if view_u in IMPACT_SOURCE_TO_LIST and impact_u == "YES":
            impacted.add(view_u)
    return impacted


def build_agent_prompt(csv_to_text, available_lists):
    """
    Ask the LLM to act as the reasoning layer: read the impact report and
    decide WHICH view-lists should be intersected. It does NOT compute the
    intersection itself (Python does that deterministically).
    """
    list_names = ", ".join(available_lists)
    
    prompt = f"""
You are an AI agent that decides which library view-lists must be processed
during IC view generation, based on an Impacted CAD View report.

You are given:
1. A report of CAD views and whether each is impacted (Yes/No).
2. A set of named view-lists you may select from: {list_names}

Selection rules (apply STRICTLY):
- If "GDS" has Impact = Yes  -> select "GDS_VIEWS"
- If "LEF" has Impact = Yes  -> select "LEF_VIEWS"
- Ignore every other CAD view in the report.
- "targeted_views" must ALWAYS be selected.
- A CAD view with Impact = No selects nothing.
- Do not invent list names. Only choose from: {list_names}

Output format (STRICT):
Return ONLY a single valid JSON object, nothing else, no markdown, no commentary:
{{"selected_lists": ["<name>", "<name>", ...]}}

The list must contain unique names only.

Impacted CAD View report:
{csv_to_text}
"""
    print(prompt)
    return prompt


def parse_agent_decision(response, available_lists):
    """
    Robustly parse the LLM JSON decision and validate every name against the
    whitelist. Returns a clean, deduplicated list of selected list-names.
    """
    if not response:
        raise RuntimeError("LLM returned no response for the selection decision.")

    text = response.strip()

    # Strip accidental markdown fences if the model added them.
    text = re.sub(r"^```(?:json)?", "", text).strip()
    text = re.sub(r"```$", "", text).strip()

    # Extract the first {...} block to be resilient to stray prose.
    match = re.search(r"\{.*\}", text, re.DOTALL)
    if not match:
        raise RuntimeError(f"Could not find JSON object in LLM response:\n{response}")

    try:
        data = json.loads(match.group(0))
    except json.JSONDecodeError as e:
        raise RuntimeError(f"Invalid JSON from LLM: {e}\nRaw:\n{response}")

    selected = data.get("selected_lists", [])
    
    if not isinstance(selected, list):
        raise RuntimeError(f"'selected_lists' is not a list:\n{response}")
        
    print("Selected: ", selected)

    whitelist = set(available_lists)
    clean = []
    seen = set()
    for name in selected:
        if not isinstance(name, str):
            continue
        name = name.strip()
        if name in whitelist and name not in seen:
            seen.add(name)
            clean.append(name)

    # Guardrail: targeted_views must always be present (rule is deterministic).
    if "targeted_views" in whitelist and "targeted_views" not in seen:
        clean.append("targeted_views")

    if not clean:
        raise RuntimeError(f"LLM selected no valid lists:\n{response}")

    print("Clean: ", clean)
    return clean



def compute_common_views(selected_list_names, list_registry, ordering_key="targeted_views"):
    if not selected_list_names:
        return []

    targeted_set = set(list_registry[ordering_key])

    combined_views = []
    seen = set()

    for name in selected_list_names:
        if name == ordering_key:
            continue
        for view in list_registry[name]:
            if view not in seen and view in targeted_set:
                seen.add(view)
                combined_views.append(view)

    return combined_views



def run_derivation_make(
    logger,
    final_views,
    sand_mat10_dir,
    product_name_dir,
    product_name,
    mat10_version,
    golden_topcells,
    libname
):
    """
    Execute derivation-make sequentially.

    New behavior:
      1. Run all views normally in final_views order.
      2. If cds_voltus is present, run it last.
      3. Before running cds_voltus, compare Apache .def.gz files.
         - if compare returns 1, run cds_voltus
         - if compare returns 0, skip cds_voltus
    """
    if not final_views:
        print("\nNo views to generate. Skipping derivation-make.")
        return

    print(f"\nGeneration will run for {len(final_views)} target(s): {final_views}\n")

    skip_cds_voltus = False

    # ------------------------------------------------------------
    # Preserve order, but move cds_voltus to the end if present
    # ------------------------------------------------------------
    ordered_views = [v for v in final_views if v != "cds_voltus"]
    if "cds_voltus" in final_views:
        ordered_views.append("cds_voltus")

    # ------------------------------------------------------------
    # Main generation loop
    # ------------------------------------------------------------
    for view in ordered_views:

        # --------------------------------------------------------
        # Before cds_voltus: compare Apache .def.gz files
        # --------------------------------------------------------
        if view == "cds_voltus":
            if all([sand_mat10_dir, product_name_dir, product_name, mat10_version, golden_topcells, libname]):
                print("\nComparing Apache .def.gz files before cds_voltus...")
                compare_result = compare_apache_def_gz_files(
                    sand_mat10_dir,
                    product_name_dir,
                    libname,
                    product_name,
                    mat10_version,
                    golden_topcells
                )

                if compare_result == 1:
                    print("\nApache DEF differences found. cds_voltus will be generated.")
                    skip_cds_voltus = False
                else:
                    print("\nNo Apache DEF differences found. cds_voltus will not be generated.")
                    skip_cds_voltus = True
            else:
                print("WARNING: Missing inputs for Apache DEF comparison flow. Skipping compare step.")
                # Decide behavior here:
                # If you want to skip cds_voltus when compare cannot run, keep True
                skip_cds_voltus = True

            if skip_cds_voltus:
                print("\nSkipping cds_voltus because Apache DEF differences were not found.\n")
                continue

        start_dt = datetime.now()
        logger.info(f"[START] derivation-make:{view} | {start_dt.strftime('%Y-%m-%d %H:%M:%S')}")

        t0 = time.perf_counter()

        queue = "reg" if view == "cds_voltus" else "long"

        cmd = [
            "bsub",
            "-q", queue,
            "-Ip",
            "derivation-make",
            "-target", view,
            "-param", "lbf-batch-resource=local",
        ]

        print(f"Running derivation-make for target: {view}")
        print("  " + " ".join(cmd))

        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )

        t1 = time.perf_counter()
        end_dt = datetime.now()
        elapsed_sec = t1 - t0
        elapsed_min = elapsed_sec / 60.0

        logger.info(
            f"[END]   derivation-make:{view} | {end_dt.strftime('%Y-%m-%d %H:%M:%S')} | "
            f"Duration: {elapsed_sec:.2f} seconds | "
            f"Duration: {elapsed_min:.2f} minutes"
        )
        logger.info("-" * 80)

        if result.returncode != 0:
            print(
                f"derivation-make failed for target '{view}'\n"
                f"stdout:\n{result.stdout}\n"
                f"stderr:\n{result.stderr}"
            )
            logger.info(f"[ERROR] derivation-make:{view} failed")
            logger.info(result.stdout)
            logger.info(result.stderr)
            print(f"Continuing to next target after failure in: {view}\n")
            continue

        print(result.stdout)
        print(f"Execution complete for target: {view}. Moving to next.\n")

    print("All derivation-make targets processed.")



def Impacted_CAD_View_Generation(logger, csv_file_path, api_key, client_app_name, targeted_views, sand_mat10_dir, product_name_dir, product_name, mat10_version, golden_topcells, libname,):
    """
    AI-agent flow:
      1. (Python) Read impact report -> deterministic pre-check.
      2. If nothing impacted -> stop, do NOT call the LLM.
      3. (LLM) Decide which view-lists to intersect.
      4. (Python) Validate decision, compute intersection, run derivation-make.
    """
    print("\n" + "=" * 70)
    print("AI AGENT: View-generation decision flow")
    print("=" * 70)

    # ---- Step 1: read report into text (input to the agent) ----
    csv_to_text, liberty_verilog_flag = convert_csv_to_text(csv_file_path)
    if not csv_to_text:
        print("\nImpact report is empty or unreadable. Generation is not triggered.")
        return

    # ---- Step 2: deterministic gate (no LLM call if nothing is impacted) ----
    impacted_sources = parse_impacted_sources(csv_to_text)
    if not impacted_sources:
        print("\nReason: None of GDS, CDL, or LEF are Impacted.")
        print("\nGeneration is not triggered.")
        return

    print(f"\nImpacted sources detected: "
          f"{sorted(impacted_sources)}")

    # ---- Build the list registry available to the agent for THIS run ----
    available_registry = dict(LIST_REGISTRY)
    available_registry["targeted_views"] = targeted_views
    #print("available_registry: ", available_registry)
    available_lists = list(available_registry.keys())
    print("available_lists: ", available_lists)
    print("csv to text:\n", csv_to_text)
    

    # ---- Step 3: LLM decides which lists to use (reasoning layer) ----
    print("\nAgent decides which view-lists to intersect...")
    prompt = build_agent_prompt(csv_to_text, available_lists)
    response = generate_token_for_agent(api_key, client_app_name, prompt)

    selected_list_names = parse_agent_decision(response, available_lists)
    print(f"\nAgent selected lists: {selected_list_names}")

    # ---- Safety cross-check: compare LLM choice with Python's own derivation ----
    expected = {IMPACT_SOURCE_TO_LIST[s] for s in impacted_sources}
    expected.add("targeted_views")
    if set(selected_list_names) != expected:
        print("\nWARNING: LLM selection differs from deterministic expectation.")
        print(f"  LLM      : {sorted(selected_list_names)}")
        print(f"  Expected : {sorted(expected)}")
        print("  Falling back to deterministic selection for safety.")
        selected_list_names = list(expected)

    # ---- Step 4: Python computes the intersection (deterministic) ----
    
    print("\n\navailable  registry: ", available_registry)
    print("\n\nselected  list  names: ", selected_list_names)
    final_views = compute_common_views(selected_list_names, available_registry)
    print(f"\nFinal view list for derivation-make: {final_views}")

    if not final_views:
        print("\nIntersection is empty. Nothing to generate. Generation is not triggered.")
        return

    # ---- Step 5: run the generation commands one by one ----
    run_derivation_make(
    logger,
    final_views,
    sand_mat10_dir,
    product_name_dir,
    product_name,
    mat10_version,
    golden_topcells,
    libname)



def move_directories_into_export(libname: str):
    """
    Move all directories from:
      SAND_MAT10/WorkDB/setup/MAT10_<libname>/
    to:
      SAND_MAT10/SANDBOX/EXPORT/
    except:
      behaviour, INTERFACE, libs, MENTOR, ccs, electrical, test
    """
    sand_mat10_dir = Path.cwd()

    source_dir = sand_mat10_dir / "WorkDB" / "setup" / f"MAT10_{libname}"
    dest_dir = sand_mat10_dir / "SANDBOX" / "EXPORT"

    if not source_dir.is_dir():
        raise FileNotFoundError(f"Source directory not found: {source_dir}")

    dest_dir.mkdir(parents=True, exist_ok=True)

    exclude_dirs = {"behaviour", "INTERFACE", "libs", "MENTOR", "ccs", "electrical", "test"}

    moved_dirs = []

    for item in source_dir.iterdir():
        if item.is_dir() and item.name not in exclude_dirs:
            src = item
            dst = dest_dir / item.name

            if dst.exists():
                if dst.is_dir() and not dst.is_symlink():
                    shutil.rmtree(dst)
                else:
                    dst.unlink()

            shutil.move(str(src), str(dst))
            moved_dirs.append(item.name)

    print(f"Moved directories to {dest_dir}: {moved_dirs}")

def make_tree_writable(root_dir: Path):
    """
    Make a directory tree writable by everyone:
      - directories: 0o777
      - files:       0o666
    """
    if not root_dir.exists():
        return

    # Make the root directory writable
    if root_dir.is_dir():
        root_dir.chmod(0o777)

        for item in root_dir.rglob("*"):
            if item.is_dir():
                item.chmod(0o777)
            elif item.is_file():
                item.chmod(0o666)


def copy_directories_into_export(libname: str, product_name: str, mat10_version: str, be_or_mat10_2_version: str):
    sand_mat10_dir = Path.cwd()
    product_root = sand_mat10_dir.parent

    source_root_mat10 = product_root / "MAT10_UPT" / f"{product_name}@{mat10_version}"
    source_root_be = product_root / "BE_UPT" / f"{product_name}@{be_or_mat10_2_version}"
    export_dir = sand_mat10_dir / "SANDBOX" / "EXPORT"

    export_dir.mkdir(parents=True, exist_ok=True)

    dirs_to_copy = [
        "packaging",
        "libs",
        "doc",
        "behaviour",
        "INTERFACE",
        "SIP",
        "ccs",
        "electrical",
        "MENTOR/FASTSCAN",
        "NOVAS",
        "ibis",
        "ipxact",
        "delay_calculation",
        "simulation",
        "test",
    ]

    copied_dirs = []

    for rel_dir in dirs_to_copy:
        src = source_root_mat10 / rel_dir
        dst = export_dir / rel_dir

        if not src.exists():
            continue

        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(src, dst)
        copied_dirs.append(rel_dir)

        # Make the entire copied tree writable
        make_tree_writable(dst)

    # Ensure export_dir/physical exists
    physical_export_dir = export_dir / "physical"
    physical_export_dir.mkdir(parents=True, exist_ok=True)

    # Make physical dir writable too
    make_tree_writable(physical_export_dir)

    # Copy .hcell if present from MAT10 physical
    copied_hcell = None
    mat10_physical_dir = source_root_mat10 / "physical"
    if mat10_physical_dir.is_dir():
        hcell_files = list(mat10_physical_dir.glob("*.hcell"))
        if hcell_files:
            hcell_src = hcell_files[0]
            hcell_dst = physical_export_dir / hcell_src.name
            shutil.copy2(hcell_src, hcell_dst)
            copied_hcell = hcell_src.name
            hcell_dst.chmod(0o666)

    # Copy all .spi files from BE physical into export physical directory
    be_physical_dir = source_root_be / "physical"
    copied_spi_files = []
    if be_physical_dir.is_dir():
        spi_files = list(be_physical_dir.glob("*.spi"))
        for spi_src in spi_files:
            spi_dst = physical_export_dir / spi_src.name
            shutil.copy2(spi_src, spi_dst)
            copied_spi_files.append(spi_src.name)
            spi_dst.chmod(0o666)

    # Copy *erc.waiver and *esd.waiver from BE MENTOR into export MENTOR/CALIBRE
    be_mentor_dir = source_root_be / "MENTOR"
    calibre_export_dir = export_dir / "MENTOR" / "CALIBRE"
    calibre_export_dir.mkdir(parents=True, exist_ok=True)

    copied_waiver_files = []
    if be_mentor_dir.is_dir():
        erc_waivers = list(be_mentor_dir.glob("*erc.waiver"))
        esd_waivers = list(be_mentor_dir.glob("*esd.waiver"))
            
        for waiver_src in erc_waivers + esd_waivers:
            if waiver_src.name.endswith("erc.waiver"):
                dst_name = f"{libname}_erc.waiver"
            elif waiver_src.name.endswith("esd.waiver"):
                dst_name = f"{libname}_esd.waiver"
            else:
                continue
                
            waiver_dst = calibre_export_dir / dst_name
            shutil.copy2(waiver_src, waiver_dst)
            copied_waiver_files.append(dst_name)
            waiver_dst.chmod(0o666)

    print("Copied directories:")
    if copied_dirs:
        for d in copied_dirs:
            print(f" - {d}")
    else:
        print(" - None")

    print("Copied files:")
    if copied_hcell:
        print(f" - physical/{copied_hcell}")

    if copied_spi_files:
        for f in copied_spi_files:
            print(f" - physical/{f}")

    if copied_waiver_files:
        for f in copied_waiver_files:
            print(f" - MENTOR/CALIBRE/{f}")

           

