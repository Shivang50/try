   );prog
);procedure
";
close FILE;
'''

    script1_path = Path.cwd() / "create_libderiv_options_file.pl"
    script2_path = Path.cwd() / "generate_postproces_il.pl"

    script1_path.write_text(perl_script, encoding="utf-8")
    script2_path.write_text(py_script, encoding="utf-8")

    script1_path.chmod(0o755)
    script2_path.chmod(0o755)

    return script1_path



def derivation_setup(
    mat09_dir: Path,
    methodology: str,
    be_version: str,
    custom_strmout_opt: Path,
    user_values: dict,
    library_values: dict,
):
    """
    Run derivation-setup with:
      - optional -refLib arguments
      - optional derivation_setup_extra_options
    """

    be_version_subpart = be_version.split("-", 1)[0].strip()

    cmd = [
        "bsub",
        "-q", "long",
        "-Ip",
        "derivation-setup",
        "-libPath", str(mat09_dir),
        "-blockgroup", methodology,
        "-libVersion", be_version_subpart,
        "-saveargfile", "SetupDB/setup.rls",
        "-add_strmout_file", str(custom_strmout_opt),
    ]

    # Add -refLib args dynamically if reflib tags are present
    reflib_count = user_values.get("reflib_count", 0)
    if reflib_count > 0:
        for idx in range(1, reflib_count + 1):
            reflib = user_values.get(f"reflib{idx}")
            version = user_values.get(f"version{idx}")
            library = library_values.get(f"library{idx}")

            if not reflib or not version or not library:
                raise ValueError(f"Missing reflib{idx}, version{idx}, or library{idx}")

            ref_path = Path(UPT_BASE) / reflib / version
            ref_lib_arg = f"{library}:{ref_path}/"
            cmd.extend(["-refLib", ref_lib_arg])

    # Add optional extra derivation setup option
    extra_opt = user_values.get("derivation_setup_extra_options", "").strip()
    if extra_opt:
        parts = extra_opt.split()
        parts[0] = f"-{parts[0]}"
        cmd.extend(parts)


    print("\nRunning derivation-setup command:")
    print(" ".join(cmd))

    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if result.returncode != 0:
        raise RuntimeError(
            "derivation-setup failed\n"
            f"stdout:\n{result.stdout}\n"
            f"stderr:\n{result.stderr}"
        )

    print(result.stdout)
       




def read_targeted_tasks(tab_file_path: Path = Path("targeted_tasks.tab")):
    """
    Read targeted_tasks.tab (created by derivation-setup) and return
    a list of view/task names. Skips the 'name' header and blank lines.
    """
    if not tab_file_path.is_file():
        raise FileNotFoundError(f"targeted_tasks.tab not found: {tab_file_path}")

    views = []
    with tab_file_path.open("r", encoding="utf-8") as f:
        for raw_line in f:
            line = raw_line.strip()
            if not line:
                continue
            if line.lower() == "name":   # skip header
                continue
            views.append(line)

    if not views:
        raise RuntimeError(f"No views found in {tab_file_path}")

    return views










