def read_user_template(template_path: str):
    """
    Read user_template from the given path.

    Mandatory keys:
      - PRODUCT_NAME
      - MAT10_VERSION
      - BE_VERSION OR MAT10_2_VERSION
      - DPDS
      - PDK

    Optional keys:
      - LTK
      - METAL_OPTION
      - PROCESS_OPTION
      - DERIVATION_SETUP_EXTRA_OPTIONS
      - REFLIB_TAG
    """

    filepath = Path(template_path).expanduser().resolve()

    if not filepath.is_file():
        raise FileNotFoundError(f"user_template not found: {filepath}")

    values = {}
    reflib_pairs = []

    with filepath.open("r", encoding="utf-8") as f:
        for raw_line in f:
            line = raw_line.strip()

            if not line or "=" not in line:
                continue

            key_part, value_part = line.split("=", 1)
            key = key_part.strip().lower()
            value = value_part.strip()

            # Parse REFLIB_TAG
            if key == "reflib_tag":
                value = value.strip()

                if not value.startswith("[") or not value.endswith("]"):
                    raise ValueError(f"Invalid REFLIB_TAG format: {value}")

                inner = value[1:-1].strip()
                if not inner:
                    raise ValueError("REFLIB_TAG is present but empty")

                entries = inner.split("][")
                for entry in entries:
                    if "@" not in entry:
                        raise ValueError(f"Invalid REFLIB_TAG entry (missing @): [{entry}]")
                    reflib_name, version = entry.split("@", 1)
                    reflib_pairs.append((reflib_name.strip(), version.strip()))
                continue

            # Store all normal keys
            values[key] = value

    # Validate mandatory keys only
    missing_keys = [k for k in REQUIRED_KEYS if k not in values]
    if missing_keys:
        raise ValueError(
            "Missing required fields in 'user_template': "
            + ", ".join(missing_keys)
        )

    empty_required = [k for k in REQUIRED_KEYS if values.get(k, "") == ""]
    if empty_required:
        raise ValueError(
            "The following required fields are empty in 'user_template': "
            + ", ".join(empty_required)
        )

    # Add reflib values if present
    for idx, (reflib, version) in enumerate(reflib_pairs, start=1):
        values[f"reflib{idx}"] = reflib
        values[f"version{idx}"] = version

    values["reflib_count"] = len(reflib_pairs)

    # Optional keys may or may not exist; that's fine
    return values

def insert_ltk_after_libderiv(ucdprod_path: Path, ltk_value: str):
    """
    Insert ltk_value immediately after the first line that starts with 'libderiv'
    in the .ucdprod file, shifting the following lines down.
    """

    if not ucdprod_path.is_file():
        raise FileNotFoundError(f".ucdprod file not found: {ucdprod_path}")

    ltk_line = ltk_value.strip()

    with ucdprod_path.open("r", encoding="utf-8") as f:
        lines = f.readlines()

    # If the ltk line is already present, do nothing
    if any(line.strip() == ltk_line for line in lines):
        print(f"ltk already present in {ucdprod_path}, skipping insertion.")
        return

    new_lines = []
    inserted = False

    for line in lines:
        new_lines.append(line)

        if not inserted and line.strip().startswith("libderiv"):
            new_lines.append(ltk_line + "\n")
            inserted = True

    if not inserted:
        raise ValueError(f"No libderiv line found in {ucdprod_path}")

    with ucdprod_path.open("w", encoding="utf-8") as f:
        f.writelines(new_lines)


def extract_libraries_from_reflibs(user_values: dict, upt_base: str = UPT_BASE):
    """
    For each reflib{n}/version{n} pair in user_values:
      - open <UPT_BASE>/<reflib>/<version>/packaging/vc.bbview
      - extract the LIBRARY value
      - return it as library{n}
    """
    libraries = {}
    reflib_count = user_values.get("reflib_count", 0)

    if reflib_count == 0:
        return libraries

    for idx in range(1, reflib_count + 1):
        reflib_key = f"reflib{idx}"
        version_key = f"version{idx}"
        library_key = f"library{idx}"

        reflib = user_values.get(reflib_key)
        version = user_values.get(version_key)

        if not reflib or not version:
            raise ValueError(f"Missing {reflib_key} or {version_key}")

        bbview_path = Path(upt_base) / reflib / version / "packaging" / "vc.bbview"

        if not bbview_path.is_file():
            raise FileNotFoundError(f"vc.bbview not found: {bbview_path}")

        library_value = None
        with bbview_path.open("r", encoding="utf-8", errors="ignore") as f:
            for raw_line in f:
                line = raw_line.strip()
                if line.startswith("LIBRARY "):
                    parts = line.split(maxsplit=1)
                    if len(parts) == 2:
                        library_value = parts[1].strip()
                        break

        if library_value is None:
            raise ValueError(f"LIBRARY entry not found in: {bbview_path}")

        libraries[library_key] = library_value

    return libraries


