def save_markdown_table_as_csv(content):

    rows = []

    for line in content.splitlines():

        line = line.strip()

        if not line.startswith("|"):
            continue

        if set(
            line.replace("|", "").strip()
        ) == {"-"}:
            continue

        parts = [

            p.strip()

            for p in line.split("|")

            if p.strip()
        ]

        if parts:
            rows.append(parts)

    if not rows:

        print("\nNo table detected in response.")
        return

    output_file = output_dir / "impacted_view_report.csv"

    with open(output_file, "w", newline="", encoding="utf-8") as csvfile:
        writer = csv.writer(csvfile)
        writer.writerows(rows)

    print("\nSaved LLM response to:", output_file)


