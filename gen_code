def setup_timing_logger(project_root: Path):
    log_dir = project_root / "Intermediate_logs"
    log_dir.mkdir(parents=True, exist_ok=True)

    log_file = log_dir / "execution_timing.log"

    logger = logging.getLogger("timing_logger")
    logger.setLevel(logging.INFO)
    logger.handlers.clear()
    logger.propagate = False

    file_handler = logging.FileHandler(log_file)
    file_handler.setFormatter(logging.Formatter("%(message)s"))
    logger.addHandler(file_handler)

    return logger, log_file

def run_with_timing(logger, func, *args, **kwargs):
    start_dt = datetime.now()
    logger.info(f"[START] {func.__name__} | {start_dt.strftime('%Y-%m-%d %H:%M:%S')}")

    t0 = time.perf_counter()
    result = func(*args, **kwargs)
    t1 = time.perf_counter()

    end_dt = datetime.now()
    elapsed_sec = t1 - t0
    elapsed_min = elapsed_sec / 60.0

    logger.info(
        f"[END]   {func.__name__} | {end_dt.strftime('%Y-%m-%d %H:%M:%S')} | "
        f"Duration: {elapsed_sec:.2f} seconds | "
        f"Duration: **({elapsed_min:.2f} minutes)**"
    )
    logger.info("-" * 80)

    return result



def compare_apache_def_gz_files(
    sand_mat10_dir: Path,
    product_name_dir: Path,
    libname: str,
    product_name: str,
    mat10_version: str,
    golden_topcells: list[str]
):
    """
    Compare generated and reference Apache .def.gz files

    Generated:
      sand_mat10_dir / "WorkDB" / "setup" / f"MAT10_{libname}" / "APACHE" / "RH" / "physical" / <topcell>.def.gz

    Reference:
      product_name_dir / "MAT10_UPT" / f"{product_name}@{mat10_version}" / "APACHE" / "RH" / "physical" / <topcell>.def.gz

    Returns:
      0 -> no differences found
      1 -> differences found and report written
    """
    gen_dir = sand_mat10_dir / "WorkDB" / "setup" / f"MAT10_{libname}" / "APACHE" / "RH" / "physical"
    ref_dir = product_name_dir / "MAT10_UPT" / f"{product_name}@{mat10_version}" / "APACHE" / "RH" / "physical"

    diff_dir = sand_mat10_dir / "Apache_def_differences"
    diff_dir.mkdir(parents=True, exist_ok=True)
    report_file = diff_dir / "Apache_def_differences.txt"

    ignore_prefixes = (
        "### Tool",
        "### RedHawk Version",
        "### Vendor",
        "### Date",
        "### Date generated",
        "### Command",
        "VERSION",
    )

    def load_filtered_lines_gz(file_path: Path):
        with gzip.open(file_path, "rt", encoding="utf-8", errors="ignore") as f:
            filtered = []
            for line in f:
                stripped = line.lstrip()
                if any(stripped.startswith(prefix) for prefix in ignore_prefixes):
                    continue
                filtered.append(line.rstrip("\n"))
        return filtered

    differences_found = False
    report_sections = []

    for topcell in golden_topcells:
        ref_file = ref_dir / f"{topcell}.def.gz"
        gen_file = gen_dir / f"{topcell}.def.gz"

        cell_report = [f"cell: {topcell}"]

        if not ref_file.is_file():
            cell_report.append(f"Missing reference file: {ref_file}")
            report_sections.append("\n".join(cell_report))
            differences_found = True
            continue

        if not gen_file.is_file():
            cell_report.append(f"Missing generated file: {gen_file}")
            report_sections.append("\n".join(cell_report))
            differences_found = True
            continue

        ref_lines = load_filtered_lines_gz(ref_file)
        gen_lines = load_filtered_lines_gz(gen_file)

        max_len = max(len(ref_lines), len(gen_lines))
        cell_diff_lines = []

        for idx in range(max_len):
            ref_line = ref_lines[idx] if idx < len(ref_lines) else None
            gen_line = gen_lines[idx] if idx < len(gen_lines) else None

            if ref_line == gen_line:
                continue

            differences_found = True
            line_no = idx + 1
            cell_diff_lines.append(f"Line {line_no}:")

            if ref_line is None:
                cell_diff_lines.append("REF: <missing>")
            else:
                cell_diff_lines.append(f"REF: {ref_line}")

            if gen_line is None:
                cell_diff_lines.append("GEN: <missing>")
            else:
                cell_diff_lines.append(f"GEN: {gen_line}")

            cell_diff_lines.append("")

        if cell_diff_lines:
            cell_report.extend(cell_diff_lines)
            report_sections.append("\n".join(cell_report))

    if differences_found:
        report_file.write_text("\n\n".join(report_sections).rstrip() + "\n", encoding="utf-8")
        print(f"Differences found. Report written to: {report_file}")
        return 1
    else:
        if report_file.exists():
            report_file.unlink()
        print("No differences found in Apache .def.gz files.")
        return 0




