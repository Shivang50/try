def read_terminals(file_path: Path) -> set[str]:
    with file_path.open("r", encoding="utf-8") as f:
        return {line.strip() for line in f if line.strip()}


def find_cell_pairs(input_dir: Path):
    pairs = []
    be_files = list(input_dir.glob(f"*{BE_SUFFIX}"))

    for be_file in be_files:
        cell_name = be_file.name[: -len(BE_SUFFIX)]
        mat_file = input_dir / f"{cell_name}{MAT10_SUFFIX}"
        if mat_file.exists():
            pairs.append((cell_name, be_file, mat_file))
        else:
            print(f"WARNING: MAT file not found for cell '{cell_name}': {mat_file}")

    return pairs


def compare_terminals(be_file: Path, mat_file: Path):
    be_terms = read_terminals(be_file)
    mat_terms = read_terminals(mat_file)

    # Option A:
    # Added   = present in BE, absent in MAT
    # Removed = present in MAT, absent in BE
    added = sorted(be_terms - mat_terms)
    removed = sorted(mat_terms - be_terms)

    return added, removed


def write_csv(rows, output_csv: Path):
    status_lines = []

    with output_csv.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)

        # Header
        writer.writerow([
            "Cell Name",
            "Terminals Added",
            "Terminals Removed"
        ])

        any_change = False

        for row in rows:

            cell_name = row[0]
            added = row[1].strip()
            removed = row[2].strip()

            # Write original row
            writer.writerow(row)

            # Build status only if something changed
            if added or removed:

                any_change = True

                parts = []

                if added:

                    added_terms = added.split()

                    if len(added_terms) == 1:
                        parts.append(
                            f"{added_terms[0]} terminal is added"
                        )
                    else:
                        parts.append(
                            f"{', '.join(added_terms)} terminals are added"
                        )

                if removed:

                    removed_terms = removed.split()

                    if len(removed_terms) == 1:
                        parts.append(
                            f"{removed_terms[0]} terminal is removed"
                        )
                    else:
                        parts.append(
                            f"{', '.join(removed_terms)} terminals are removed"
                        )

                status_line = (
                    f"Status: For cell {cell_name} "
                    + " and ".join(parts)
                )

                status_lines.append(status_line)

        # Add blank line before status
        writer.writerow([])

        # Case 2 -> nothing changed in any cell
        if not any_change:

            writer.writerow(
                ["Status: No terminals are added or removed"]
            )

        else:

            for line in status_lines:

                writer.writerow([line])

    #print(f"Report written to: {output_csv.resolve()}")

def parse_lef(lef_path: str):
    records = []

    macro_name = None
    pin_name = None
    in_port = False

    macro_re = re.compile(r'^\s*MACRO\s+(\S+)\s*$')
    pin_re = re.compile(r'^\s*PIN\s+(\S+)\s*$')
    port_re = re.compile(r'^\s*PORT\s*$')
    layer_re = re.compile(r'^\s*LAYER\s+(\S+)\s*;')
    end_re = re.compile(r'^\s*END\s+(\S+)\s*$')
    end_port_re = re.compile(r'^\s*END\s*$')

    with open(lef_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip()

            m = macro_re.match(line)
            if m:
                macro_name = m.group(1)
                pin_name = None
                in_port = False
                continue

            m = pin_re.match(line)
            if m:
                pin_name = m.group(1)
                in_port = False
                continue

            if port_re.match(line):
                in_port = True
                continue

            if in_port:
                m = layer_re.match(line)
                if m and macro_name and pin_name:
                    records.append((macro_name, pin_name, m.group(1)))
                    continue

                if end_port_re.match(line):
                    in_port = False
                    continue

            m = end_re.match(line)
            if m:
                end_name = m.group(1)

                if pin_name and end_name == pin_name:
                    pin_name = None
                    in_port = False
                    continue

                if macro_name and end_name == macro_name:
                    macro_name = None
                    pin_name = None
                    in_port = False
                    continue

    # Uniquify + sort
    unique_records = sorted(set(records))
    return unique_records


def write_csv_sip(records, out_csv, header=True):
    with open(out_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        if header:
            writer.writerow(["cell_name", "pin_name", "port_layer"])
        writer.writerows(records)


def _pin_layers_from_report_log(report_log):
    """
    Collect every layer that appears in report.log with the "pin" purpose.

    Matches lines of the form:
        difference on lpp:("C5" "pin")
    Returns a set of lowercased layer names.
    """
    pin_layers = set()
    lpp_re = re.compile(r'lpp\s*:\s*\(\s*"([^"]+)"\s+"([^"]+)"\s*\)')

    with open(report_log, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            m = lpp_re.search(line)
            if m and m.group(2).strip().lower() == "pin":
                pin_layers.add(m.group(1).strip().lower())

    return pin_layers


def check_sip_lef():
    """
    Returns "Yes" or "No".

    "No"  -> SIP LEF file missing, or no qualifying port layer found
    "Yes" -> port layers include nitride, or one of them appears in
             report.log with the "pin" purpose
    """
    lef_path = (
        Path(UPT_BASE)
        / product_name
        / mat10_version
        / "SIP"
        / "physical"
        / f"{libname}.lef"
    )

    if not lef_path.is_file():
        return "No"

    records = parse_lef(str(lef_path))

    cwd = Path.cwd()
    dump_file = cwd / SIP_LEF_DUMP
    write_csv_sip(records, str(dump_file), header=False)

    # Unique third-column values, first-seen order preserved
    port_layers = []
    for _cell, _pin, layer in records:
        if layer not in port_layers:
            port_layers.append(layer)

    if not port_layers:
        return "No"

    if any(layer.lower() == "nitride" for layer in port_layers):
        return "Yes"

    report_log = cwd / "Output" / "report.log"
    if not report_log.is_file():
        return "No"

    pin_layers = _pin_layers_from_report_log(report_log)

    for layer in port_layers:
        if layer.lower() in pin_layers:
            return "Yes"

    return "No"





