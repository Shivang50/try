def create_ucdprod_file(pdk_value: str, ic_value: str):
    """
    Create .ucdprod file in current working directory.

    Input format expected:
        PDK:name version
        ic:name version

    Output file format:
        name version
        name version
    """

    cwd = Path.cwd()
    ucdprod_path = cwd / ".ucdprod"

    try:
        # Split only once
        pdk_parts = pdk_value.split(maxsplit=1)
        ic_parts = ic_value.split(maxsplit=1)

        if len(pdk_parts) != 2:
            raise ValueError("PDK must be in format: name version")

        if len(ic_parts) != 2:
            raise ValueError("ic must be in format: name version")

        with open(ucdprod_path, "w", encoding="utf-8") as f:
            f.write(f"{pdk_parts[0]} {pdk_parts[1]}\n")
            f.write(f"{ic_parts[0]} {ic_parts[1]}\n")

        print(f"Created {ucdprod_path}")

    except Exception as e:
        raise RuntimeError(
            f"Failed to create .ucdprod file: {e}"
        )
