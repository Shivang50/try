def generate_operation_model_block(
        table4_rows,
        table1_map,
        table2_map,
        bidir_tx,
        bidir_rx):

    out = []

    out.append("\t:operation-model\t\t'(\n")

    for row in table4_rows:

        mode = row.get("Mode","").strip()

        if not mode:
            continue

        map_voltage = row.get("Map_voltage","").strip()
        resistance = row.get("Resistance","").strip()

        include_file = row.get("Include File","").strip()

        stuck_to_raw = row.get("Stuck-to","").strip()

        keep_stuck = row.get(
            "Keep-stuck-pins-in-cond",
            ""
        ).strip()

        forbidden = row.get(
            "Forbidden",
            ""
        ).strip()

        electrical = row.get(
            "Electrical",
            ""
        ).strip()

        pin_voltage = row.get(
            "Pin-Voltage",
            ""
        ).strip()

        remove_name = row.get(
            "Remove_name",
            ""
        ).strip()

        resolved_stuck = resolve_stuck_to(
            stuck_to_raw,
            table2_map
        )

        operation_names = build_operation_names(
            mode,
            map_voltage,
            resistance
        )

        for op_name in operation_names:

            ###################################################
            # Resolve SUP1 SUP2 SUP3 SUP4
            ###################################################

            sup = extract_supply(op_name)

            resolved_voltage = table1_map.get(
                sup,
                ""
            )

            ###################################################
            # BIDIR TX
            ###################################################

            if mode == "Bidir_TX":

                write_bidir_tx(

                    out,

                    op_name,

                    resolved_voltage,

                    resolved_stuck,

                    keep_stuck,

                    forbidden,

                    pin_voltage,

                    electrical,

                    include_file,

                    remove_name,

                    bidir_tx

                )

            ###################################################
            # BIDIR TX1
            ###################################################

            elif mode == "Bidir_TX1":

                write_bidir_tx1(

                    out,

                    op_name,

                    resolved_voltage,

                    resolved_stuck,

                    keep_stuck,

                    forbidden,

                    pin_voltage,

                    electrical,

                    include_file,

                    remove_name,

                    bidir_tx

                )







            ###################################################
            # BIDIR RX
            ###################################################

            elif mode == "Bidir_RX":

                write_bidir_rx(

                    out,

                    op_name,

                    resolved_voltage,

                    resolved_stuck,

                    keep_stuck,

                    forbidden,

                    electrical,

                    include_file,

                    remove_name,

                    bidir_rx

                )

            ###################################################
            # LEAK
            ###################################################

            elif mode.lower() == "leak":

                write_leak(

                    out,

                    op_name,

                    resolved_voltage,

                    resolved_stuck,

                    include_file,

                    remove_name

                )

            ###################################################
            # ONLY CAP
            ###################################################

            elif mode.lower() in ("only_cap", "onlycap"):

                write_only_cap(

                    out,

                    op_name,

                    resolved_voltage,

                    resolved_stuck,

                    include_file,

                    remove_name

                )

            ###################################################
            # Unknown Mode
            ###################################################

            else:

                print(f"Skipping unknown mode : {mode}")

    out.append("\t)\n")

    return out



def resolve_stuck_to(stuck_to_text, table2_map):

    if not stuck_to_text:
        return ""

    resolved = []

    for key in split_values(stuck_to_text):

        key = key.strip()

        if key in table2_map:
            resolved.append(table2_map[key])

    return "".join(resolved)

